{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARCYN configuration (legacy and current)",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "theme": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
              "default": "#D64545"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
              "default": "#0A0A0A"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
              "default": "#FFFFFF"
            },
            "font_family": {
              "type": "string",
              "default": "JetBrainsMono NF",
              "maxLength": 100
            },
            "font_scale": {
              "type": "number",
              "minimum": 0.7,
              "maximum": 1.8,
              "default": 1
            },
            "width": {
              "type": "number",
              "minimum": 640,
              "maximum": 1920,
              "default": 920
            },
            "height": {
              "type": "number",
              "minimum": 360,
              "maximum": 1080,
              "default": 490
            },
            "corner_radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 30,
              "default": 9
            },
            "border_width": {
              "type": "number",
              "minimum": 0,
              "maximum": 4,
              "default": 1
            },
            "card_height": {
              "type": "number",
              "minimum": 64,
              "maximum": 160,
              "default": 94
            },
            "spacing": {
              "type": "number",
              "minimum": 0,
              "maximum": 24,
              "default": 6
            },
            "layout": {
              "enum": [
                "rows",
                "compact",
                "grid"
              ],
              "default": "rows"
            },
            "particles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120,
              "default": 60
            },
            "glow_opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.28
            },
            "motion_amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            },
            "cursor_trail": {
              "type": "boolean",
              "default": true
            },
            "acrylic": {
              "type": "boolean",
              "default": true
            },
            "vignette": {
              "type": "boolean",
              "default": true
            },
            "scanlines": {
              "type": "boolean",
              "default": true
            },
            "animations": {
              "type": "boolean",
              "default": true,
              "description": "Continuous ambient effects only. Boot and launch timing is retained."
            },
            "reduced_effects": {
              "type": "boolean",
              "default": false,
              "description": "Disable particles, trail, glow, acrylic and scanlines without shortening cinematics."
            },
            "compact_mode": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true
        },
        "behavior": {
          "type": "object",
          "properties": {
            "idle_timeout_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400,
              "default": 10
            },
            "always_on_top": {
              "type": "boolean",
              "default": true
            },
            "close_on_launch": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": true
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "default": ""
              },
              "label": {
                "type": "string",
                "default": ""
              },
              "description": {
                "type": "string",
                "default": ""
              },
              "subtitle": {
                "type": "string",
                "default": ""
              },
              "type": {
                "type": "string",
                "default": ""
              },
              "session": {
                "type": "string",
                "default": ""
              },
              "state": {
                "type": "string",
                "default": ""
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
                "default": "#D64545"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "default": ""
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "working_directory": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "apps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "websites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "default": ""
          },
          "label": {
            "type": "string",
            "default": ""
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "subtitle": {
            "type": "string",
            "default": ""
          },
          "type": {
            "type": "string",
            "default": ""
          },
          "session": {
            "type": "string",
            "default": ""
          },
          "state": {
            "type": "string",
            "default": ""
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
            "default": "#D64545"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cmd": {
                  "type": "string",
                  "default": ""
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "working_directory": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "apps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "websites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "folders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  ]
}
