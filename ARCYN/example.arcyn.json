{
  "$schema": "./arcyn.schema.json",
  "theme": {
    "color_mode": "system",
    "system_accent": true,
    "accent": "#D64545",
    "glow_opacity": 0.28,
    "scanlines": true,
    "animations": true
  },
  "behavior": {
    "idle_timeout_seconds": 10,
    "always_on_top": true,
    "close_on_launch": true
  },
  "modes": [
    {
      "description": "Development stack online",
      "accent": "#D64545",
      "websites": [
        "https://github.com",
        "https://chatgpt.com"
      ],
      "folders": [],
      "label": "CODE",
      "targets": [
        {
          "instance_policy": "reuse_or_launch",
          "cmd": "wt.exe",
          "args": [],
          "kind": "application",
          "id": "terminal"
        },
        {
          "instance_policy": "reuse_or_launch",
          "cmd": "code",
          "args": [],
          "kind": "application",
          "id": "editor"
        }
      ],
      "actions": [
        {
          "kind": "wait",
          "timeout_ms": 1000,
          "label": "Brief pause after editor window",
          "depends_on": [
            "editor"
          ],
          "id": "settle",
          "delay_ms": 200
        }
      ]
    },
    {
      "name": "BROWSE",
      "description": "Research and references",
      "accent": "#45A0D6",
      "apps": [],
      "websites": [
        "https://www.wikipedia.org",
        "https://news.ycombinator.com",
        "https://stackoverflow.com"
      ],
      "folders": []
    },
    {
      "name": "CREATE",
      "description": "Design and media workspace",
      "accent": "#D6A045",
      "apps": [
        "mspaint"
      ],
      "websites": [
        "https://www.pinterest.com"
      ],
      "folders": []
    }
  ],
  "schema_version": 2
}
