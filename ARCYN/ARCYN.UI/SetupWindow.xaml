<Window x:Class="ARCYN.UI.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Set up ARCYN" Width="740" Height="620" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UIFont}">
 <Grid Margin="32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ARCYN" FontWeight="SemiBold"/><TextBlock x:Name="StepCounter" Grid.Column="1" Foreground="{DynamicResource TextDimBrush}"/></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><Grid>
   <StackPanel x:Name="StepWelcome"><TextBlock Style="{DynamicResource PageTitle}" Text="A place for everything you do"/><TextBlock Style="{DynamicResource Caption}" Text="Build a workspace once. Open your apps, websites and folders together whenever you need them." Margin="0,0,0,24"/>
    <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource IconFont}" FontSize="48" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,12,0,24"/>
    <TextBlock Text="Start with one workspace" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"/>
    <TextBlock Text="Choose a name and add the things you use together. You can change everything later, or add window layouts and workflow steps in the workspace editor." TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
   <StackPanel x:Name="StepMode" Visibility="Collapsed"><TextBlock Style="{DynamicResource PageTitle}" Text="Name your workspace"/><TextBlock Style="{DynamicResource Caption}" Text="Work, study, a new project—give it a name that makes sense to you." Margin="0,0,0,24"/>
    <TextBlock Text="Name"/><TextBox x:Name="ModeNameInput" AutomationProperties.Name="Workspace name"/>
    <TextBlock Text="Description (optional)"/><TextBox x:Name="ModeDescInput" AutomationProperties.Name="Workspace description"/>
    <TextBlock Text="Workspace color" Margin="0,8,0,8"/>
    <WrapPanel><RadioButton x:Name="ColorBlue" GroupName="Accent" Content="Blue" IsChecked="True"/><RadioButton x:Name="ColorRed" GroupName="Accent" Content="Red"/><RadioButton x:Name="ColorGreen" GroupName="Accent" Content="Green"/><RadioButton x:Name="ColorOrange" GroupName="Accent" Content="Orange"/><RadioButton x:Name="ColorPurple" GroupName="Accent" Content="Purple"/></WrapPanel>
   </StackPanel>
   <StackPanel x:Name="StepApps" Visibility="Collapsed"><TextBlock Style="{DynamicResource PageTitle}" Text="Add your apps"/><TextBlock Style="{DynamicResource Caption}" Text="Choose applications for this workspace. ARCYN reuses matching windows when possible." Margin="0,0,0,24"/><ItemsControl x:Name="AppsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveApp_Click"/><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Browse for an app" Click="AddApp_Click" Margin="0,12,0,16"/>
    <TextBlock Text="Or enter an application path"/><TextBox x:Name="AppQuickInput" AutomationProperties.Name="Application path or command"/><Button Content="Add app" Click="AddAppQuick_Click"/>
   </StackPanel>
   <StackPanel x:Name="StepFolders" Visibility="Collapsed"><TextBlock Style="{DynamicResource PageTitle}" Text="Keep your folders close"/><TextBlock Style="{DynamicResource Caption}" Text="Add project folders or locations you want to open with this workspace." Margin="0,0,0,24"/><ItemsControl x:Name="FoldersList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveFolder_Click"/><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Browse for a folder" Click="AddFolder_Click" Margin="0,12,0,0"/>
   </StackPanel>
   <StackPanel x:Name="StepWebsites" Visibility="Collapsed"><TextBlock Style="{DynamicResource PageTitle}" Text="Add websites"/><TextBlock Style="{DynamicResource Caption}" Text="Your pages open in your default browser." Margin="0,0,0,24"/><ItemsControl x:Name="WebsitesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveWebsite_Click"/><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Website address" Margin="0,16,0,0"/><TextBox x:Name="WebsiteInput" AutomationProperties.Name="Website URL"/><Button Content="Add website" Click="AddWebsite_Click"/>
   </StackPanel>
   <StackPanel x:Name="StepReview" Visibility="Collapsed"><TextBlock Style="{DynamicResource PageTitle}" Text="Your workspace is ready to save"/><TextBlock Style="{DynamicResource Caption}" Text="Review your choices. Saving opens ARCYN; your applications stay closed until you open a workspace." Margin="0,0,0,24"/>
    <ItemsControl x:Name="ModesPreviewList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,8"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Add another workspace" Click="AddMode_Click"/>
   </StackPanel>
  </Grid></ScrollViewer>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="BackButton" Content="Back" Click="Back_Click" Visibility="Collapsed"/><Button x:Name="NextButton" Content="Get started" Click="Next_Click" Style="{DynamicResource PrimaryActionButton}"/><Button x:Name="FinishButton" Content="Save and open ARCYN" Click="Finish_Click" Visibility="Collapsed" Style="{DynamicResource PrimaryActionButton}"/></WrapPanel>
  <TextBlock x:Name="StatusBar" Grid.Row="3" TextWrapping="Wrap" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextDimBrush}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>