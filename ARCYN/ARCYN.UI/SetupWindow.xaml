<Window x:Class="ARCYN.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ARCYN Setup"
        Width="740"
        Height="600"
        WindowStyle="None"

        Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False"

        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UIFont}">
    <Window.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource FontSize22}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="StepDesc" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource FontSize12}"/><Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource FontSize11}"/><Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="WizInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="FontSize" Value="{DynamicResource FontSize13}"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="{DynamicResource FontSize12}"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}"><Setter Property="FontSize" Value="{DynamicResource FontSize12}"/></Style>
        <Style x:Key="ChipStyle" TargetType="Border"><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="10,6"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/></Style>
    </Window.Resources>

<Grid x:Name="RootGrid" Background="Transparent" MouseDown="RootGrid_MouseDown">
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" />
        <Rectangle x:Name="SetupGlow" Style="{StaticResource AmbientGlow}" />
        <Rectangle x:Name="SetupScanlines" Style="{StaticResource Scanlines}" />
        <Rectangle x:Name="SetupVignette" Style="{StaticResource Vignette}" />

        <Grid x:Name="ShellHost" Margin="12,10">
            <Border x:Name="MainBorder"
                    CornerRadius="20"
                    Background="{DynamicResource ShellBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceLineBrush}"
                    Effect="{DynamicResource GlowAccent}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header - HUD style top bar -->
            <Border Grid.Row="0"
                    CornerRadius="12"
                    Background="#12000000"
                    Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4"
                             Fill="{StaticResource AccentBrightBrush}"
                             VerticalAlignment="Center"
                             Effect="{StaticResource GlowAccentSoft}" />
                    <TextBlock Grid.Column="1"
                               Text="ARCYN"
                               FontSize="{DynamicResource FontSize12}"
                               FontWeight="Bold"
                               Margin="6,0,10,0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="SETUP"
                               FontSize="{DynamicResource FontSize11}"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               x:Name="StepCounter"
                               FontSize="{DynamicResource FontSize11}"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"/>
                    <Rectangle Grid.Column="4"
                               Height="1"
                               Fill="{StaticResource BorderSubtleBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0" />
                    <Button Grid.Column="5"
                            Style="{StaticResource NavButton}"
                            Content="✖"
                            AutomationProperties.Name="Close setup"
                            Width="26" Height="26"
                            Padding="0"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,12,20,0">

                <!-- Step 1: Welcome -->
                <Grid x:Name="StepWelcome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StepTitle}" Text="Make yourself at home"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource StepDesc}"
                               Text="Your apps, places and projects, ready together. Start with one workspace and make it your own."/>
                    <Border Grid.Row="2"
                            Background="#0A000000"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↗"
                                       FontSize="{DynamicResource FontSize14}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSize12}" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="Create workspaces (modes)"/> <LineBreak/>
                                <Run Text="Each mode opens your apps, sites, and folders together"/> <LineBreak/>
                                <Run Text="Press a number key to launch — fast"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource ChipStyle}" Padding="8,3">
                            <TextBlock Text="Made for your flow" FontSize="{DynamicResource FontSize11}" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <Border Style="{StaticResource ChipStyle}" Padding="8,3">
                            <TextBlock Text="Windows native" FontSize="{DynamicResource FontSize11}" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Step 2: Create Mode -->
                <Grid x:Name="StepMode" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StepTitle}" Text="Name your workspace"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource StepDesc}"
                               Text="Each mode is a workspace. Give it a name and description."/>
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="NAME"/>
                    <TextBox Grid.Row="3" x:Name="ModeNameInput" Style="{StaticResource WizInput}" AutomationProperties.Name="Workspace name"
                            />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="DESCRIPTION"/>
                    <TextBox Grid.Row="5" x:Name="ModeDescInput" Style="{StaticResource WizInput}" AutomationProperties.Name="Workspace description"
                            />
                    <Grid Grid.Row="6" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="ACCENT COLOR"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="ColorRed" GroupName="Accent" IsChecked="True" AutomationProperties.Name="Red accent"
                                         ToolTip="Warm red">
                                <RadioButton.Content>
                                    <Ellipse Width="20" Height="20" Fill="#D64545" Margin="2"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="ColorBlue" GroupName="Accent" Margin="8,0,0,0" AutomationProperties.Name="Blue accent"
                                         ToolTip="Clear blue">
                                <RadioButton.Content>
                                    <Ellipse Width="20" Height="20" Fill="#4580D6" Margin="2"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="ColorGreen" GroupName="Accent" Margin="8,0,0,0" AutomationProperties.Name="Green accent"
                                         ToolTip="Fresh green">
                                <RadioButton.Content>
                                    <Ellipse Width="20" Height="20" Fill="#45D680" Margin="2"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="ColorOrange" GroupName="Accent" Margin="8,0,0,0" AutomationProperties.Name="Orange accent"
                                         ToolTip="Amber">
                                <RadioButton.Content>
                                    <Ellipse Width="20" Height="20" Fill="#D6A045" Margin="2"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="ColorPurple" GroupName="Accent" Margin="8,0,0,0" AutomationProperties.Name="Purple accent"
                                         ToolTip="Soft violet">
                                <RadioButton.Content>
                                    <Ellipse Width="20" Height="20" Fill="#A045D6" Margin="2"/>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Step 3: Apps -->
                <Grid x:Name="StepApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StepTitle}" Text="Bring your apps"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource StepDesc}"
                               Text="Pick apps to launch with this mode. You can add more later."/>
                    <Border Grid.Row="2"
                            Background="#0A000000"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            CornerRadius="12"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <ItemsControl x:Name="AppsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipStyle}" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="{DynamicResource FontSize12}" Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="X"
                                                        FontSize="{DynamicResource FontSize10}"
                                                        Foreground="{StaticResource AccentLightBrush}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,0"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="RemoveApp_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource NavButton}"
                                Content="+ Browse"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Click="AddApp_Click"/>
                        <TextBox x:Name="AppQuickInput" AutomationProperties.Name="Application path or command"
                                 Style="{StaticResource WizInput}"
                                 Width="200"
                                 Margin="8,0,0,0"
                                />
                        <Button Style="{StaticResource NavButton}"
                                Content="+ Add"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="4,0,0,0"
                                Click="AddAppQuick_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Step 4: Folders -->
                <Grid x:Name="StepFolders" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StepTitle}" Text="ADD FOLDERS"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource StepDesc}"
                               Text="Add folders to open in Explorer when this mode launches."/>
                    <Border Grid.Row="2"
                            Background="#0A000000"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            CornerRadius="12"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <ItemsControl x:Name="FoldersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipStyle}" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="{DynamicResource FontSize12}" Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="X"
                                                        FontSize="{DynamicResource FontSize10}"
                                                        Foreground="{StaticResource AccentLightBrush}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,0"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="RemoveFolder_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="3" Style="{StaticResource NavButton}"
                            Content="+ Browse Folders"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Click="AddFolder_Click"/>
                </Grid>

                <!-- Step 5: Websites -->
                <Grid x:Name="StepWebsites" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StepTitle}" Text="ADD WEBSITES"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource StepDesc}"
                               Text="Websites to open in your default browser."/>
                    <Border Grid.Row="2"
                            Background="#0A000000"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            CornerRadius="12"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <ItemsControl x:Name="WebsitesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipStyle}" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="{DynamicResource FontSize12}" Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="X"
                                                        FontSize="{DynamicResource FontSize10}"
                                                        Foreground="{StaticResource AccentLightBrush}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,0"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="RemoveWebsite_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WebsiteInput" AutomationProperties.Name="Website URL"
                                 Style="{StaticResource WizInput}"
                                />
                        <Button Grid.Column="1"
                                Style="{StaticResource NavButton}"
                                Content="+ Add"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="6,0,0,0"
                                Click="AddWebsite_Click"/>
                    </Grid>
                </Grid>

                <!-- Step 6: Review -->
                <Grid x:Name="StepReview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StepTitle}" Text="REVIEW &amp; LAUNCH"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource StepDesc}"
                               Text="Here are your workspaces. You can edit them anytime in the config file."/>
                    <Border Grid.Row="2"
                            Background="#0A000000"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            CornerRadius="12"
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <ItemsControl x:Name="ModesPreviewList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipStyle}" Margin="0,0,0,4" Padding="8,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{Binding AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           FontSize="{DynamicResource FontSize11}" Foreground="{StaticResource TextDimBrush}"
                                                           Margin="14,2,0,0"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Summary}"
                                                           FontSize="{DynamicResource FontSize10}" Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="14,4,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource NavButton}"
                                Content="+ Add Another Mode"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Click="AddMode_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Footer - nav buttons -->
            <Border Grid.Row="2"
                    CornerRadius="12"
                    Background="#12000000"
                    Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1"
                            x:Name="BackButton"
                            Style="{StaticResource NavButton}"
                            Content="Back"
                            Foreground="{StaticResource TextDimBrush}"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="Back_Click"/>
                    <Button Grid.Column="2"
                            x:Name="NextButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Next"
                            Foreground="#0A0A0A"
                            Click="Next_Click"/>
                    <Button Grid.Column="2"
                            x:Name="FinishButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Launch ARCYN"
                            Foreground="#0A0A0A"
                            Visibility="Collapsed"
                            Click="Finish_Click"/>
                </Grid>
            </Border>

            <!-- Footer - status bar -->
            <Border Grid.Row="3"
                    CornerRadius="12"
                    Background="#12000000"
                    Padding="6,2"
                    Margin="0,2,0,0">
                <TextBlock x:Name="StatusBar"
                           FontSize="{DynamicResource FontSize10}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
