<Window x:Class="ARCYN.UI.EditModeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ARCYN — Workspace" Width="980" Height="740" MinWidth="480" MinHeight="560" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UIFont}">
 <Window.Resources>
  <Style x:Key="CommandFields" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="command"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="WindowFields" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="window"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="WaitFields" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="wait"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="24,16,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Workspace" Style="{DynamicResource PageTitle}"/>
   <StackPanel x:Name="WorkspaceFields">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Name"/><TextBox x:Name="NameInput" AutomationProperties.Name="Workspace name"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Description"/><TextBox x:Name="DescInput" AutomationProperties.Name="Description"/></StackPanel>
   </Grid>
   <Expander Header="Optional details" Margin="0,2,0,8"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="Category (optional)"/><TextBox x:Name="TypeInput" AutomationProperties.Name="Mode type"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Session"/><TextBox x:Name="SessionInput" AutomationProperties.Name="Session"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="State"/><TextBox x:Name="StateInput" AutomationProperties.Name="State"/></StackPanel>
    <StackPanel Grid.Column="3"><TextBlock Text="Accent (#RRGGBB)"/><TextBox x:Name="AccentInput" AutomationProperties.Name="Workspace accent colour"/></StackPanel>
   </Grid></Expander>
   </StackPanel>
  </StackPanel>
  <TabControl Grid.Row="1" x:Name="EditorTabs" SelectionChanged="Tabs_SelectionChanged">
   <TabItem Header="Targets"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="TargetsPane" Margin="10" SizeChanged="Pane_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/></Grid.RowDefinitions>
     <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock TextWrapping="Wrap" Style="{DynamicResource Caption}" Text="Choose what opens with this workspace. Select a target for more options." Margin="0,0,0,8"/>
      <DataGrid Grid.Row="1" x:Name="TargetsGrid" CanUserAddRows="True" CanUserDeleteRows="False" MinHeight="120" MaxHeight="280" SelectionChanged="Target_SelectionChanged" AutomationProperties.Name="Ordered launch targets">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Target" Binding="{Binding Command}" Width="2*" MinWidth="250"/>
        <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="*" MinWidth="120"/>
       </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
       <Button Content="Browse files" Click="Browse_Click"/><Button Content="Website" Click="Website_Click"/><Button Content="Folder" Click="Folder_Click"/><Button Content="Installed apps" Click="Discover_Click"/><Button Content="Command" Click="CommandEntry_Click"/>
       <Button Content="Move up" Click="Up_Click"/><Button Content="Move down" Click="Down_Click"/><Button Content="Remove" Click="Remove_Click"/>
      </WrapPanel>
     </Grid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="TargetInspector">
       <TextBlock Text="Selected target" FontWeight="SemiBold" Margin="0,0,0,16"/>
       <TextBlock Text="Kind"/><ComboBox x:Name="KindInput" SelectedValue="{Binding Target.Kind}" AutomationProperties.Name="Target kind"/>
       <Expander x:Name="TargetAdvanced" Header="Advanced target settings"><StackPanel Margin="0,8,0,0">
       <TextBlock Text="Instance policy"/><ComboBox x:Name="PolicyInput" SelectedValue="{Binding Target.InstancePolicy}" AutomationProperties.Name="Instance policy"/>
       <TextBlock Text="Readiness"/><ComboBox x:Name="ReadinessInput" SelectedValue="{Binding Target.Readiness}" AutomationProperties.Name="Readiness requirement"/>
       <TextBlock Text="Timeout (ms)"/><TextBox Text="{Binding Target.TimeoutMs}" AutomationProperties.Name="Target timeout milliseconds"/>
       <TextBlock Text="Working directory"/><TextBox Text="{Binding WorkingDirectory}" AutomationProperties.Name="Target working directory"/>
       <Expander x:Name="MatchDisclosure" Header="Window matching" Foreground="{DynamicResource TextPrimaryBrush}"><StackPanel Margin="0,8,0,0">
        <Button Content="Choose running window" Click="Bind_Click"/>
        <TextBlock Text="Executable identity (full path)"/><TextBox Text="{Binding MatchExecutable}" AutomationProperties.Name="Matching executable path"/>
        <TextBlock Text="Application identity (optional)"/><TextBox Text="{Binding MatchAppId}" AutomationProperties.Name="Matching application identity"/>
        <TextBlock Text="Window class (optional)"/><TextBox Text="{Binding MatchClass}" AutomationProperties.Name="Matching window class"/>
        <TextBlock Text="Window title (optional)"/><TextBox Text="{Binding MatchTitle}" AutomationProperties.Name="Matching window title"/>
        <CheckBox Content="Title contains text" IsChecked="{Binding TitleContains}" Foreground="{DynamicResource TextPrimaryBrush}"/>
       </StackPanel></Expander>
       <TextBlock Text="Run after" Margin="0,12,0,4"/><ListBox x:Name="TargetDependencies" SelectionMode="Multiple" DisplayMemberPath="Label" Height="90" SelectionChanged="Dependencies_Changed" AutomationProperties.Name="Target prerequisites"/>
       </StackPanel></Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </ScrollViewer></TabItem>
   <TabItem Header="Layout"><ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel><Button Content="Capture matched windows" Click="Capture_Click"/><Button Content="Refresh displays" Click="Displays_Click"/><Button Content="Add selected target" Click="AddLayout_Click"/><Button Content="Remove placement" Click="RemoveLayout_Click"/></WrapPanel>
     <Border Grid.Row="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,6">
      <DockPanel Margin="8"><WrapPanel x:Name="MonitorCaptions" DockPanel.Dock="Top"/>
      <Canvas MinHeight="180" x:Name="LayoutMap" ClipToBounds="True" SizeChanged="Map_SizeChanged" AutomationProperties.Name="Saved workspace monitor layout"/>
      </DockPanel>
     </Border>
     <DataGrid Grid.Row="2" x:Name="LayoutGrid" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Editable window placements">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Target" Binding="{Binding Label}" IsReadOnly="True" Width="*" MinWidth="140"/>
       <DataGridComboBoxColumn x:Name="LayoutMonitorColumn" Header="Monitor" SelectedValueBinding="{Binding Monitor}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="*" MinWidth="120"/>
       <DataGridTextColumn Header="X %" Binding="{Binding X, StringFormat=F1}" Width="Auto" MinWidth="60"/>
       <DataGridTextColumn Header="Y %" Binding="{Binding Y, StringFormat=F1}" Width="Auto" MinWidth="60"/>
       <DataGridTextColumn Header="W %" Binding="{Binding Width, StringFormat=F1}" Width="Auto" MinWidth="60"/>
       <DataGridTextColumn Header="H %" Binding="{Binding Height, StringFormat=F1}" Width="Auto" MinWidth="60"/>
       <DataGridComboBoxColumn x:Name="LayoutStateColumn" Header="State" SelectedItemBinding="{Binding Layout.State}" Width="Auto" MinWidth="110"/>
       <DataGridCheckBoxColumn Header="Focus" Binding="{Binding Focus}" Width="Auto" MinWidth="70"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="3" TextWrapping="Wrap" Text="Drag windows; resize from lower-right corner. Numeric controls provide keyboard editing. Changes affect saved layout only; disconnected displays fall back to primary on restore." Margin="0,8,0,0"/>
    </Grid>
   </ScrollViewer></TabItem>
   <TabItem Header="Actions"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="ActionsPane" Margin="10" SizeChanged="Pane_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/></Grid.RowDefinitions>
     <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock TextWrapping="Wrap" Style="{DynamicResource Caption}" Text="Optional steps for this workspace. Commands always require your review before running." Margin="0,0,0,8"/>
      <DataGrid Grid.Row="1" x:Name="ActionsGrid" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="120" MaxHeight="280" SelectionChanged="Action_SelectionChanged" AutomationProperties.Name="Workspace actions">
       <DataGrid.Columns><DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" IsReadOnly="True" Width="110" MinWidth="90"/><DataGridTextColumn Header="Label" Binding="{Binding Action.Label}" Width="*" MinWidth="200"/></DataGrid.Columns>
      </DataGrid>
      <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Window" Click="AddWindow_Click"/><Button Content="Wait" Click="AddWait_Click"/><Button Content="Command" Click="AddCommand_Click"/><Button Content="↑" AutomationProperties.Name="Move action up" Click="ActionUp_Click"/><Button Content="↓" AutomationProperties.Name="Move action down" Click="ActionDown_Click"/><Button Content="Remove" Click="RemoveAction_Click"/></WrapPanel>
     </Grid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ActionInspector">
      <TextBlock Text="Selected action" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="Timeout (ms)"/><TextBox Text="{Binding Action.TimeoutMs}" AutomationProperties.Name="Action timeout milliseconds"/>
      <StackPanel Style="{StaticResource WindowFields}"><TextBlock Text="Window operation"/><ComboBox x:Name="OperationInput" SelectedValue="{Binding Operation}" AutomationProperties.Name="Window operation"/></StackPanel>
      <StackPanel x:Name="ActionTargetPanel"><TextBlock Text="Target (empty = fixed wait)"/><ComboBox x:Name="ActionTargetInput" DisplayMemberPath="Label" SelectedValuePath="Target.Id" SelectedValue="{Binding TargetId}" AutomationProperties.Name="Action target"/><Button Content="Use fixed delay" Click="FixedWait_Click"/></StackPanel>
      <StackPanel Style="{StaticResource WaitFields}"><TextBlock Text="Delay (ms; when no target selected)"/><TextBox Text="{Binding DelayMs}" AutomationProperties.Name="Wait delay milliseconds"/></StackPanel>
      <StackPanel Style="{StaticResource CommandFields}">
       <TextBlock Text="Executable"/><TextBox Text="{Binding Command}" AutomationProperties.Name="Command executable"/>
       <TextBlock Text="Arguments (Windows quoting)"/><TextBox Text="{Binding Arguments}" AutomationProperties.Name="Command arguments"/>
       <TextBlock Text="Working directory"/><TextBox Text="{Binding WorkingDirectory}" AutomationProperties.Name="Command working directory"/>
       <CheckBox Content="Request elevation (UAC)" IsChecked="{Binding Elevate}" Foreground="{DynamicResource TextPrimaryBrush}"/>
      </StackPanel>
      <TextBlock Text="Run after" Margin="0,12,0,4"/><ListBox x:Name="ActionDependencies" SelectionMode="Multiple" DisplayMemberPath="Label" Height="110" SelectionChanged="Dependencies_Changed" AutomationProperties.Name="Action prerequisites"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,10,0,0">
   <WrapPanel DockPanel.Dock="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/><Button Content="Save workspace" Style="{DynamicResource PrimaryActionButton}" IsDefault="True" Click="Save_Click"/></WrapPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" MaxHeight="70" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel>
 </Grid>
</Window>
