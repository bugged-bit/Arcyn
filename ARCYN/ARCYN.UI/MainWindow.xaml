<Window x:Class="ARCYN.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ARCYN" Width="920" Height="490" WindowStyle="None" Background="{DynamicResource WindowBrush}" ShowInTaskbar="False" Topmost="True"
 WindowStartupLocation="CenterScreen" ResizeMode="NoResize" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
 FontFamily="{DynamicResource UIFont}" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <DataTemplate x:Key="ModeCardTemplate">
   <Grid>
    <Button Style="{DynamicResource WorkstationPanelStyle}" Click="ModeButton_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Subtitle}" MinHeight="{DynamicResource CardHeight}">
     <Grid Margin="0,0,44,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource IconFont}" FontSize="24" Foreground="{Binding AccentBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Subtitle}" Visibility="{DynamicResource WorkspaceDescriptionVisibility}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0" FontSize="{DynamicResource FontSize14}"/>
       <TextBlock Text="{Binding TargetSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetSummary}" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding ShortcutHint}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextDimBrush}"/>
     </Grid>
    </Button>
    <Button Style="{DynamicResource SubtleButton}" Click="WorkspaceMenu_Click" Tag="{Binding Id}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="8" ToolTip="Workspace actions" AutomationProperties.Name="Workspace actions">
     <TextBlock Text="&#xE712;" FontFamily="{DynamicResource IconFont}" FontSize="16"/>
    </Button>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="RootGrid" Background="Transparent" MouseDown="RootGrid_MouseDown">
  <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>
  <Rectangle x:Name="AmbientGlow" Style="{StaticResource AmbientGlow}"/>
  <Rectangle x:Name="StartupFlash" Fill="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
  <Rectangle x:Name="ScanlineLayer" Style="{StaticResource Scanlines}"/>
  <Rectangle x:Name="VignetteLayer" Style="{StaticResource Vignette}"/>
  <Canvas x:Name="TrailCanvas" IsHitTestVisible="False" Panel.ZIndex="100"/>
  <Grid x:Name="ShellHost" Margin="16,12">
   <Border x:Name="MainBorder" CornerRadius="8" Width="6" Height="6" MaxWidth="{Binding ActualWidth, ElementName=ShellHost}" MaxHeight="{Binding ActualHeight, ElementName=ShellHost}"
    HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ShellBrush}" BorderThickness="1" BorderBrush="{DynamicResource SurfaceLineBrush}">
    <Grid>
                    <Grid x:Name="BootOverlay" Margin="16,12" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="ARCYN / Welcome back"
                                       FontSize="{DynamicResource FontSize9}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="Workspace launcher"
                                       FontSize="{DynamicResource FontSize9}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <Rectangle Grid.Column="1"
                                       Height="1"
                                       Fill="{DynamicResource BorderSubtleBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                        </Grid>

                        <TextBlock x:Name="BootTitle"
                                   Grid.Row="1"
                                   FontSize="{DynamicResource FontSize20}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="BootSubtitle"
                                   Grid.Row="2"
                                   FontSize="{DynamicResource FontSize9}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14" />

                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Height="2"
                                    Background="{DynamicResource LiteralBrush08000000}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <Rectangle x:Name="BootProgress"
                                           Fill="{DynamicResource AccentBrightBrush}"
                                           HorizontalAlignment="Stretch">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <TextBlock x:Name="BootPercent"
                                       Grid.Column="1"
                                       FontSize="{DynamicResource FontSize9}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       Margin="10,0,0,0"
                                       Text="0%" />
                        </Grid>

                        <TextBlock x:Name="BootLog"
                                   Grid.Row="4"
                                   FontSize="{DynamicResource FontSize9}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Margin="0,0,0,8"
                                   LineHeight="15" />

                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BootReady"
                                       Grid.Column="0"
                                       FontSize="{DynamicResource FontSize11}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource AccentBrightBrush}"
                                       Opacity="0"
                                       Text="SYSTEM READY"
                                       HorizontalAlignment="Left" />
                        </Grid>
                    </Grid>


     <Grid x:Name="MainHUD" Opacity="0" Margin="24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="ARCYN" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="Workspaces" FontSize="{DynamicResource FontSize22}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
       <WrapPanel Grid.Column="1" VerticalAlignment="Center">
        <Button Content="New workspace" Click="NewWorkspace_Click" ToolTip="New workspace (Ctrl+N)"/>
        <Button Style="{DynamicResource SubtleButton}" Click="Appearance_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"><TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="16"/></Button>
        <Button Style="{DynamicResource SubtleButton}" Click="CloseHud_Click" ToolTip="Close (Esc)" AutomationProperties.Name="Close ARCYN"><TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="14"/></Button>
       </WrapPanel>
      </Grid>
      <Border x:Name="ModePanel" Grid.Row="1">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel><TextBlock x:Name="RunFeedback" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/><Grid x:Name="DashboardGrid"/></StackPanel>
       </ScrollViewer>
      </Border>
      <Border x:Name="LaunchPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Path x:Name="SpinnerArc" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Width="28" Height="28" Stretch="Uniform" Data="M 3,14 A 11,11 0 1,1 25,14" RenderTransformOrigin=".5,.5" Margin="0,0,16,0"><Path.RenderTransform><RotateTransform x:Name="SpinnerRotation"/></Path.RenderTransform></Path>
         <StackPanel Grid.Column="1"><TextBlock x:Name="LaunchModeLabel" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"/><TextBlock x:Name="LaunchSessionLabel" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
         <Button Grid.Column="2" Content="Cancel" Click="CloseHud_Click"/>
        </Grid>
        <ScrollViewer x:Name="LaunchFeedScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16"><TextBlock x:Name="LaunchFeedText" FontSize="{DynamicResource FontSize14}" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/></ScrollViewer>
        <StackPanel Grid.Row="2"><TextBlock x:Name="LaunchStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
         <Grid Margin="0,12,0,8" Height="3" Background="{DynamicResource SurfaceLineBrush}"><Rectangle Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0"><Rectangle.RenderTransform><ScaleTransform x:Name="LaunchProgressScale" ScaleX="0"/></Rectangle.RenderTransform></Rectangle></Grid>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LaunchProgressText" FontSize="{DynamicResource FontSize12}"/><TextBlock x:Name="LaunchTargetCount" Grid.Column="1" FontSize="{DynamicResource FontSize12}"/></Grid>
        </StackPanel>
       </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="FooterHint" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="{DynamicResource FontSize12}"/>
       <TextBlock x:Name="FooterIdle" Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource TextDimBrush}" FontSize="{DynamicResource FontSize12}"/>
      </Grid>
      <TextBlock x:Name="PhaseLabel" Visibility="Collapsed"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
